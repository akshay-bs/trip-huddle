filters:
  and:
    - type == "day"
    - '!file.inFolder("Templates")'
formulas:
  slack_hrs: if(daylight_hrs, (daylight_hrs - (if(drive_hrs, drive_hrs, 0) + if(activity_hrs, activity_hrs, 0) - if(predawn_hrs, predawn_hrs, 0))).round(1), "")
  verdict: if(formula.slack_hrs == "", "", if(formula.slack_hrs < 0, "too much", if(formula.slack_hrs < 1.5, "tight", "ok")) + if(rule_bends, " (" + rule_bends.toString() + " rule bend" + if(rule_bends > 1, "s", "") + ")", ""))
properties:
  formula.slack_hrs:
    displayName: Slack hrs
  formula.verdict:
    displayName: Verdict
  early_start:
    displayName: Early start
  daylight_hrs:
    displayName: Daylight hrs
  predawn_hrs:
    displayName: Pre-dawn hrs
  rule_bends:
    displayName: Rule bends
  travel_verdict:
    displayName: Travel check
  start_time:
    displayName: Start
  backtrack_km:
    displayName: Doubles back km
views:
  - type: table
    name: Days
    order:
      - file.name
      - date
      - start_base
      - end_base
      - stay
      - locations
      - start_time
      - early_start
      - sunrise
      - sunset
      - daylight_hrs
      - drive_hrs
      - activity_hrs
      - predawn_hrs
      - formula.slack_hrs
      - formula.verdict
      - travel_verdict
      - total_walk_km
      - backtrack_km
      - rule_bends
    sort:
      - property: day
        direction: ASC
    summaries:
      drive_hrs: Sum
      activity_hrs: Sum
      total_walk_km: Sum
      backtrack_km: Sum
