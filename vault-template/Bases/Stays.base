filters:
  and:
    - type == "stay"
    - '!file.inFolder("Templates")'
formulas:
  cost_per_split: if(est_total, est_total / 1, "")
properties:
  formula.cost_per_split:
    displayName: Per person
  est_total:
    displayName: Total
  price_per_night:
    displayName: Per night
views:
  - type: table
    name: Shortlist by town
    filters:
      and:
        - decision != "dropped"
    groupBy:
      property: base_town
      direction: ASC
    order:
      - file.name
      - stay_type
      - decision
      - price_per_night
      - price_basis
      - heating
      - hot_water
      - parking_for_group_vehicle
      - recommended_by
  - type: table
    name: Booking tracker
    filters:
      and:
        - decision == "selected"
    order:
      - file.name
      - base_town
      - check_in
      - check_out
      - booking_status
      - booking_ref
      - est_total
      - advance_paid
      - formula.cost_per_split
      - cancellation_policy
    sort:
      - property: check_in
        direction: ASC
    summaries:
      est_total: Sum
      advance_paid: Sum
      formula.cost_per_split: Sum
  - type: table
    name: Dropped
    filters:
      and:
        - decision == "dropped"
    order:
      - file.name
      - base_town
      - decision_reason
      - decided_on
  - type: cards
    name: Cards
    order:
      - file.name
      - base_town
      - price_per_night
      - google_rating
      - decision
    image: note.cover
  - type: table
    name: In this itinerary
    filters:
      and:
        - file.hasLink(this.file)
    order:
      - file.name
      - base_town
      - nights
      - price_per_night
      - google_rating
      - heating
      - hot_water
      - room_config
      - decision
  - type: map
    name: View
    coordinates: note.location
